# Variáveis usadas pelo docker-compose.yml para subir o stack completo
# (Postgres + backend). Copie para `.env` e ajuste os valores — em
# produção, troque todos os segredos.

POSTGRES_USER=etiquetas
POSTGRES_PASSWORD=etiquetas
POSTGRES_DB=etiquetas
POSTGRES_PORT=5432

BACKEND_PORT=3000
NODE_ENV=development

# Gere com: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Origens autorizadas a chamar a API (separadas por vírgula). Em produção,
# a URL real do frontend — nunca "*".
CORS_ORIGIN=http://localhost:5173

# URL pública usada para montar o link curto do QR Code.
PUBLIC_APP_URL=http://localhost:3000
