DATABASE_URL="postgresql://etiquetas:etiquetas@localhost:5432/etiquetas?schema=public"

# Gere com: openssl rand -hex 32 — nunca reaproveite o placeholder abaixo
# fora do ambiente local. O refresh token em si não é um JWT (é um valor
# aleatório opaco guardado com hash no banco, ver RefreshToken no schema),
# então só existe um secret de JWT aqui mesmo.
JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=3000

# Origens autorizadas a chamar a API (separadas por vírgula). Em produção,
# a URL real do frontend — nunca "*".
CORS_ORIGIN="http://localhost:5173"

# URL base usada para montar o link curto do QR Code (ex.: https://app.exemplo.com.br/l/{codigo})
PUBLIC_APP_URL="http://localhost:3000"

# Usados só pelo `npm run db:seed`, pra criar o primeiro usuário Admin.
SEED_ADMIN_EMAIL="admin@etiquetas.local"
SEED_ADMIN_SENHA="trocar-esta-senha"
